import java.util.Scanner;

public class Main
{
	public static void main(String[] args) {
		Scanner input = new Scanner(System.in);

        System.out.print("Enter centimeters: ");
        double centimeters = input.nextDouble();

        int meters = (int) (centimeters / 100);

        double remainCm = centimeters - (meters * 100);

        System.out.println("Whole meters: " + meters);
        System.out.println("Remaining centimeters: " + remainCm);

        int number = 10;
        double widenedNum = number;

        System.out.println("Implicit widening: " + widenedNum);

        double decimalNum = 12.75;
        int narrowedNum = (int) decimalNum;

        System.out.println("Explicit narrowing: " + narrowedNum);

        
	}
}
